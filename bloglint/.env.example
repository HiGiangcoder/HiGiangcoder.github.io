# BlogLint lấy cấu hình từ biến môi trường. Sao chép file này thành .env
# nếu chạy local, và KHÔNG commit .env.

# Bắt buộc nếu dùng Ollama Cloud (https://ollama.com).
# BLOGLINT_OLLAMA_API_KEY=

# Mặc định: http://localhost:11434 nếu không có API key,
# https://ollama.com nếu có API key.
# BLOGLINT_OLLAMA_BASE_URL=http://localhost:11434

# BLOGLINT_OLLAMA_MODEL=gpt-oss:120b-cloud

# BLOGLINT_TIMEOUT=120

# Không bật mặc định. CLI vẫn cần cờ --allow-network.
# BLOGLINT_ALLOW_NETWORK=0

# BLOGLINT_DATA_DIR=./data
